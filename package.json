{
  "name": "roam-codex-bridge",
  "version": "0.9.2",
  "private": false,
  "type": "module",
  "description": "Local bridge that connects the Roam Codex extension to the Codex App Server.",
  "scripts": {
    "build": "esbuild src/extension.jsx --bundle --format=esm --platform=browser --target=es2022 --jsx-factory=window.React.createElement --outfile=extension.js",
    "dev": "node --watch bridge.mjs",
    "dev:extension": "npm run build -- --watch",
    "start": "node bridge.mjs",
    "test": "npm run build && node --test",
    "check": "npm run build && node --check bridge.mjs && node --check extension.js && node --check bin.mjs && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "roam-codex-bridge": "bin.mjs"
  },
  "files": [
    "bridge.mjs",
    "bin.mjs",
    "runtime-agent.md",
    "runtime-work-agent.md",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.8"
  }
}
