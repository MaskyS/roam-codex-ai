{
  "name": "roam-codex-lab",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A minimal Roam-to-Codex app-server development loop.",
  "scripts": {
    "dev": "node --watch bridge.mjs",
    "start": "node bridge.mjs",
    "show-token": "node bridge.mjs --show-token",
    "build": "esbuild src/extension.js --bundle --format=esm --outfile=extension.js --jsx-factory=React.createElement --jsx-fragment=React.Fragment --log-level=warning",
    "watch": "npm run build -- --watch=forever",
    "test": "node --test",
    "check": "npm run build && node --check bridge.mjs && node --check extension.js && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  }
}
